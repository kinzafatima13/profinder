// PROFINDER — Database Schema
// Prisma + SQLite (swap to PostgreSQL for production)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id                  String   @id @default(cuid())
  name                String
  nameZh              String?
  country             String   @default("China")
  province            String?
  city                String?
  officialUrl         String?
  sourceUrl           String?
  description         String?
  agencyNumber        String?
  openAlexId          String?
  logoUrl             String?
  dataStatus          String   @default("unverified") // verified | unverified | needs_review | outdated
  dataSource          String?
  applicationUrl      String?
  applicationFee      String?
  applicationDeadline String?
  scholarshipUrl      String?
  scholarshipDeadline String?
  verifiedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programs      Program[]
  professors    Professor[]
  scholarships  Scholarship[]
}

model Program {
  id                   String   @id @default(cuid())
  universityId         String
  degree               String
  major                String
  teachingLang         String?
  requirements         String?
  programUrl           String?
  deadline             String?
  openingDate          String?
  scholarshipDeadline  String?
  tuition              String?
  applicationFee       String?
  duration             String?
  englishReq           String?
  ielts                String?
  toefl                String?
  gpaRequirement       String?
  cscType              String?
  supervisorRequired   String?
  applicationUrl       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  university           University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([degree])
  @@index([major])
}

model Professor {
  id                String   @id @default(cuid())
  universityId      String
  name              String
  firstName         String?
  lastName          String?
  nameZh            String?
  position          String?
  school            String?
  department        String?
  country           String?
  email             String?
  profileUrl        String?
  personalWebsite   String?
  researchInterests String?
  researchKeywords  String?
  lab               String?
  publications      String?
  publicationCount  Int?
  orcid             String?
  openAlexId        String?
  semanticScholarId String?
  profileIsPersonal Boolean  @default(false)
  dataStatus        String   @default("unverified") // verified | unverified | needs_review | outdated
  dataSource        String?
  lastSyncedAt      DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  researchAreas     ProfessorResearchArea[]
  applications      Application[]
  savedBy           SavedProfessor[]
  publicationRows   Publication[]
  sources           ProfessorSource[]
  topics            ProfessorTopic[]

  @@index([orcid])
  @@index([openAlexId])
  @@index([semanticScholarId])
  @@index([universityId])
}

model ResearchArea {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  keywords    String?
  parentId    String?
  createdAt   DateTime @default(now())

  professors  ProfessorResearchArea[]
}

model ProfessorResearchArea {
  professorId    String
  researchAreaId String

  professor      Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)
  researchArea   ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([professorId, researchAreaId])
}

model Scholarship {
  id            String   @id @default(cuid())
  universityId  String?
  name          String
  type          String?
  requirements  String?
  deadline      String?
  officialUrl   String?
  advantages    String?
  coverage      String?
  dataStatus    String   @default("unverified")
  createdAt     DateTime @default(now())

  university    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
}

model Student {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  degree             String?
  major              String?
  academicBackground String?
  researchInterests  String?
  skills             String?
  projects           String?
  cvText             String?
  preferredCountries String?
  preferredUniversities String?
  plan               String   @default("free") // free | pro
  role               String   @default("student") // student | admin
  resetToken         String?
  resetTokenExp      DateTime?
  nationality        String?
  gpa                String?
  englishTest        String?
  fundingGoals       String?
  matchCheckedAt     String?
  phone              String?
  resumeText         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applications       Application[]
  savedProfessors    SavedProfessor[]
  subscription       Subscription?
  usageCounters      UsageCounter[]
}

model SavedProfessor {
  id          String   @id @default(cuid())
  studentId   String
  professorId String
  createdAt   DateTime @default(now())

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([studentId, professorId])
}

model Subscription {
  id                     String    @id @default(cuid())
  studentId              String    @unique
  plan                   String
  status                 String
  provider               String    @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  priceId                String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id        String   @id @default(cuid())
  studentId String
  feature   String
  period    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feature, period])
}

model BillingEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Application {
  id            String   @id @default(cuid())
  studentId     String
  universityId  String?
  professorId   String?
  programId     String?
  scholarship          String?
  degree               String?
  programName          String?
  status               String   @default("Saved")
  contactStatus        String?
  deadline             String?
  followUpDate         String?
  scholarshipDeadline  String?
  applicationUrl       String?
  notes                String?
  documentsJson        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor     Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
}

model Publication {
  id                    String   @id @default(cuid())
  professorId           String
  title                 String
  year                  Int?
  authors               String?
  venue                 String?
  citationCount         Int?
  abstract              String?
  doi                   String?
  openAlexWorkId        String?
  semanticScholarPaperId String?
  sourceUrl             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  professor             Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([doi])
  @@index([openAlexWorkId])
}

model ProfessorSource {
  id          String   @id @default(cuid())
  professorId String
  source      String
  externalId  String?
  sourceUrl   String?
  fetchedAt   DateTime @default(now())

  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([source, externalId])
}

model Topic {
  id             String   @id @default(cuid())
  name           String   @unique
  openAlexTopicId String?
  professors     ProfessorTopic[]
}

model ProfessorTopic {
  professorId String
  topicId     String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([professorId, topicId])
}
