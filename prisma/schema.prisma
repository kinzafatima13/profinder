// PROFINDER — Database Schema
// Production uses PostgreSQL. Local dev can still use SQLite via DATABASE_URL=file:./dev.db
// only if you temporarily switch provider back; production must stay postgresql.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
