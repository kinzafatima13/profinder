# Production (Vercel) — required
DATABASE_URL=
NEXTAUTH_URL=https://www.profindernow.com
NEXTAUTH_SECRET=
ADMIN_EMAILS=profinderofficiall@gmail.com

# Private document storage (server-only). Required in production.
# Create a Vercel Blob store and set the read/write token. Access is private.
BLOB_READ_WRITE_TOKEN=

# Password-reset email (required for forgot-password in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional billing (leave empty until Stripe is verified)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
